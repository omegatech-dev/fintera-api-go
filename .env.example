# Application
PORT=8081
ENVIRONMENT=development

# Database (same as Rails)
DATABASE_URL=postgres://localhost:5432/fintera_api_development?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-development
JWT_EXPIRATION_HOURS=24

# Storage
STORAGE_PATH=./storage

# Background Workers
WORKER_COUNT=5

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=noreply@fintera.app
ENABLE_EMAIL_NOTIFICATIONS=false

# Rollbar
ROLLBAR_TOKEN=your_rollbar_access_token_here
ROLLBAR_CODE_VERSION=v1.0.0
ROLLBAR_SERVER_ROOT=github.com/sjperalta/fintera-api
