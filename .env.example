# Application
PORT=8081
ENVIRONMENT=development

# Database (same as Rails)
DATABASE_URL=postgres://localhost:5432/fintera_api_development?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-development
JWT_EXPIRATION_HOURS=24

# Storage
STORAGE_PATH=./storage

# Automatically apply seller commission credits when a commission is paid.
# Keep disabled in production until the backend and admin UI rollout is ready.
# Enable in staging first to validate the full cycle: cancel a paid contract,
# the seller creates a new contract, and paying that commission consumes the
# credit automatically.
COMMISSION_CREDIT_NETTING_ENABLED=false

# Request limits
# Maximum JSON request body size in bytes (multipart uploads are exempt; they
# enforce their own per-endpoint limits). Default 2 MiB.
MAX_JSON_BODY_BYTES=2097152

# Background Workers
WORKER_COUNT=5

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8081

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=noreply@fintera.app
ENABLE_EMAIL_NOTIFICATIONS=false
# Local/staging: redirect all outbound mail to a Resend test inbox.
# Use delivered@resend.dev or delivered+<env>@resend.dev.
# Leave empty in production so real recipients are used.
EMAIL_OVERRIDE_TO=

# Customer portal (deep links in emails)
PORTAL_URL=http://localhost:5173

# Rollbar
ROLLBAR_TOKEN=your_rollbar_access_token_here
ROLLBAR_ENVIRONMENT=development
ROLLBAR_CODE_VERSION=v1.0.0
ROLLBAR_SERVER_ROOT=github.com/sjperalta/fintera-api
